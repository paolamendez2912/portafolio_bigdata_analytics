    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "# Cargar los datos desde la BD a un DataFrame para graficar rápido\n",
    "df = pd.DataFrame(db.all())\n",
    "\n",
    "# Configurar estilo visual\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.figure(figsize=(8, 10))\n",
    "\n",
    "# Gráfico 1: Distribución de precios por categoría\n",
    "orden_categorias = df.groupby(\"categoria\")[\"precio_usd\"].sum().sort_values(ascending=False).index\n",
    "plt.subplot(2, 1, 1)\n",
    "\n",
    "sns.barplot(\n",
    "    data=df,\n",
    "    x=\"categoria\",\n",
    "    y=\"precio_usd\",\n",
    "    estimator=sum,\n",
    "    errorbar=None,\n",
    "    palette=\"viridis\",\n",
    "    order=orden_categorias\n",
    ")\n",
    "\n",
    "plt.title(\"Valor Total de Inventario por Categoría\")\n",
    "plt.xticks(rotation=90)\n",
    "plt.ylabel(\"Monto ($ USD)\")\n",
    "\n",
    "# Gráfico 2: Relación entre Precio y Calificación\n",
    "plt.subplot(2, 1, 2)\n",
    "sns.scatterplot(\n",
    "    data=df,\n",
    "    x=\"precio_usd\",\n",
    "    y=\"calificacion\",\n",
    "    hue=\"categoria\",\n",
    "    s=85,\n",
    "    alpha=0.8,\n",
    ")\n",
    "plt.title(\"Precio vs Calificación de Clientes\")\n",
    "plt.xlabel(\"Precio ($ USD)\")\n",
    "plt.ylabel(\"Calificación (1 a 5)\")\n",
    "plt.xlim(0, 15000)\n",
    "plt.legend(bbox_to_anchor=(1.01, 1), loc='upper left')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ],
